{
  "bluetooth": {
    "mac_address": "00:07:80:E0:3F:F0",
    "sink_name": "bluez_output.00_07_80_E0_3F_F0.1"
  },
  "storage": {
    "ssd_mount": "/mnt/didier_ssd"
  },
  "npu": {
    "device": "/dev/hailo0",
    "pcie_address": "0001:01:00.0"
  },
  "ollama": {
    "base_url": "http://localhost:11435",
    "model": "llama3.2:1b",
    "timeout_seconds": 120,
    "num_predict": 64,
    "temperature": 0.4,
    "autotune_enabled": true,
    "autotune_interval_seconds": 1800,
    "autotune_cooldown_seconds": 1800,
    "autotune_prompt": "Réponds en une phrase courte: Bonjour.",
    "autotune_num_predict": 32,
    "autotune_temperature": 0.2,
    "autotune_timeout_seconds": 30,
    "autotune_bench_output": "logs/bench_llm.csv",
    "autotune_min_b": 1.0,
    "autotune_tps_target": 8.0,
    "autotune_models": [
      "llama3.2:1b",
      "llama3.2:3b"
    ],
    "keep_alive": "10m",
    "experts": {
      "jardinage": {
        "model": "qwen2.5:1.5b",
        "system_prompt": "Tu es un expert jardinage. Conseils pratiques, saisonniers, sûrs. Pose une question si l'info manque."
      },
      "bricolage": {
        "model": "gemma2:2b",
        "system_prompt": "Tu es un expert bricolage. Donne des étapes courtes et sécurisées, avec outils nécessaires."
      },
      "cuisine": {
        "model": "qwen2.5:1.5b",
        "system_prompt": "Tu es un chef. Donne des recettes simples, des variantes, et des timings précis."
      },
      "code": {
        "model": "qwen2.5-coder:1.5b",
        "system_prompt": "Tu es un assistant code. Réponses courtes, exécutables, avec attention aux erreurs."
      },
      "resume": {
        "model": "phi3.5:3.8b",
        "system_prompt": "Tu es un expert synthèse. Résume en points clés, puis propose une action."
      },
      "fun": {
        "model": "llama3.2:1b",
        "system_prompt": "Tu es créatif et amusant. Réponses courtes, ton léger."
      }
    }
  },
  "coding": {
    "model": "qwen2.5-coder:1.5b",
    "num_predict": 400,
    "temperature": 0.2,
    "system_prompt": "Tu es un assistant de code précis, concis, et pragmatique. Donne des réponses courtes et exécutables."
  },
  "clawbot": {
    "model": "llama3.2:1b",
    "num_predict": 96,
    "temperature": 0.3,
    "system_prompt": "Tu es Clawbot, un agent OpenClaw. Tu réponds en français, brièvement, avec un ton direct. Tu suis AGENTS/TOOLS/SOUL/USER et la mémoire persistante.",
    "enabled": true,
    "interval_seconds": 300,
    "report_path": "data/clawbot_report.json",
    "max_reports": 50,
    "summary_max_chars": 400,
    "write_memory": true
  },
  "music": {
    "enabled": true,
    "model_dir": "models/musicgen-small-onnx",
    "output_path": "data/music.wav"
  },
  "personality": {
    "system_prompt": "Tu es Didier : gentil, bougon désabusé, presque omniscient. Tu aides avec pragmatisme, une pointe d'ironie, sans être méchant. Tu es bref et clair.",
    "catchphrases": [
      "On ne sent pas le cul des gens qu'on ne connait pas.",
      "Je crois aux vertus de l’optimisme. Ce n’est pas facile, mais ça ne sert à rien d’être pessimiste. Anticiper le malheur, c’est le vivre deux fois. Mieux vaut croire que les choses vont aller mieux.",
      "Les cons ça ose tout, c'est même à ça qu'on les reconnait."
    ]
  },
  "openclaw": {
    "workspace": "openclaw",
    "bootstrap_files": [
      "AGENTS.md",
      "MEMORY.md",
      "SOUL.md",
      "USER.md",
      "TOOLS.md"
    ]
  },
  "memory": {
    "path": "data/memory.json",
    "max_items": 1200,
    "max_chars": 24000
  },
  "asr": {
    "enabled": true,
    "alsa_device": "hw:2,0",
    "sample_rate": 16000,
    "chunk_seconds": 2,
    "command_chunk_seconds": 3,
    "channels": 4,
    "threads": 4,
    "beam_size": 1,
    "best_of": 1,
    "no_fallback": true,
    "no_timestamps": true,
    "use_vad": false,
    "vad_threshold": 0.5,
    "vad_min_speech_ms": 250,
    "vad_min_silence_ms": 100,
    "vad_max_speech_s": 0,
    "vad_speech_pad_ms": 30,
    "vad_samples_overlap": 0.1,
    "autotune_enabled": true,
    "autotune_interval_seconds": 1800,
    "autotune_cooldown_seconds": 1800,
    "autotune_run_bench": true,
    "autotune_sample_seconds": 3,
    "autotune_no_record": true,
    "autotune_bench_output": "logs/bench_asr.csv",
    "autotune_bench_script": "scripts/bench_asr.py",
    "command_rtf_target": 1.2,
    "command_min_quality": "base",
    "command_allow_below_min_quality": false,
    "wake_model_path": "models/ggml-tiny.bin",
    "allow_inline_command": false,
    "wake_word": "Yo! Didier! Cafarte?",
    "wake_word_aliases": [
      "Yo! Didier! Ca farte?",
      "Yo Didier cafarte",
      "Yo Didier ca farte"
    ],
    "wake_timeout_seconds": 12,
    "language": "fr",
    "whisper_cpp_bin": "bin/whisper.cpp",
    "model_path": "models/ggml-small.bin"
  },
  "tts": {
    "model_path": "voices/kokoro-v1.0.onnx",
    "voices_path": "voices/voices-v1.0.bin",
    "output_path": "data/didier_speaks.wav"
  },
  "vision": {
    "camera_index": 0,
    "camera_device": "/dev/video0",
    "capture_backend": "opencv",
    "usb_id_vendor": "1415",
    "usb_id_product": "2000",
    "enable_live": true,
    "watchdog_enabled": false,
    "kill_on_open": false,
    "width": 640,
    "height": 480,
    "fps": 30,
    "fourcc": "YUYV",
    "zones": [
      {
        "name": "zone-centre",
        "x": 0.2,
        "y": 0.2,
        "w": 0.6,
        "h": 0.6,
        "color": "#22d3ee"
      },
      {
        "name": "zone-large",
        "x": 0.05,
        "y": 0.05,
        "w": 0.9,
        "h": 0.9,
        "color": "#f97316"
      }
